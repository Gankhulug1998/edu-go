OPENAI_API_KEY=sk-...
PORT=3000
# Optional: gpt-image-2 | gpt-image-1 | dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-2
# PostgreSQL. Default (unset) = local unix socket: postgres:///kanjimn?host=/var/run/postgresql
# Production example: postgres://kanjimn:password@127.0.0.1:15432/kanjimn
DATABASE_URL=

# MinIO / S3-compatible object storage for card image bytes.
# All four required to enable image save/serve.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=kanjimn
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional (MinIO ignores it); default us-east-1
S3_REGION=us-east-1
