{
  "name": "edu-go",
  "version": "0.1.0",
  "description": "API-driven Chinese hieroglyph learning card generator (Mongolian)",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "fonts": "bash scripts/download-fonts.sh",
    "test:lin": "tsx scripts/test-render.ts examples/lin.json output/lin.png",
    "batch:ai": "tsx scripts/batch-generate.ts",
    "migrate:images": "tsx scripts/migrate-images-to-minio.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@hono/node-server": "^1.13.7",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.6.14",
    "openai": "^4.77.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "satori": "^0.12.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "better-sqlite3": "^12.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
